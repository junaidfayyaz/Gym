# Database Connection (Local Mongo or MongoDB Atlas URI)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gym_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=supersecretgymjwtkey123456!

# Nodemailer / SMTP Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gym_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=owner@titanfitgym.com
